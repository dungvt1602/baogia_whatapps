// Prisma schema cho app báo giá (chuyển từ Telegram bot sang DB)
// Sinh từ thiết kế DBML. DB: PostgreSQL (Supabase).
//
// Lệnh thường dùng:
//   npx prisma migrate dev --name init   -> tạo migration + áp vào DB
//   npx prisma generate                  -> sinh lại Prisma Client
//   npx prisma studio                    -> mở GUI xem/sửa dữ liệu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL không còn đặt ở đây nữa.
  // - Migrate/introspect: lấy từ prisma.config.ts (DIRECT_URL, port 5432)
  // - Runtime: PrismaClient dùng driver adapter với DATABASE_URL (pooler 6543)
}

// ============================================================
// NGƯỜI DÙNG & PHÂN QUYỀN
// ============================================================

model User {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String?   @map("full_name") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  // N-N: user <-> role (qua bảng user_roles)
  userRoles UserRole[]
  // N-N: user <-> quotation (qua bảng user_quotations)
  userQuotations UserQuotation[]
  // Người thực hiện thay đổi trong audit_logs (changed_by)
  auditLogsChanged AuditLog[] @relation("AuditLogChangedBy")

  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  userRoles UserRole[]

  @@map("roles")
}

// N-N: user <-> role. Khoá chính kép (user_id, role_id).
model UserRole {
  userId     BigInt   @map("user_id")
  roleId     BigInt   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// BÁO GIÁ
// ============================================================

model Quotation {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  title       String?   @db.VarChar(255)
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency    String    @default("VND") @db.VarChar(10)
  status      String    @default("DRAFT") @db.VarChar(30)
  issuedDate  DateTime? @map("issued_date") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  // N-N: user <-> quotation
  userQuotations UserQuotation[]
  // 1-N: quotation -> quotation_template_sends
  templateSends QuotationTemplateSend[]

  @@map("quotations")
}

// N-N: user <-> báo giá. Khoá chính kép (user_id, quotation_id).
model UserQuotation {
  userId          BigInt   @map("user_id")
  quotationId     BigInt   @map("quotation_id")
  roleInQuotation String?  @map("role_in_quotation") @db.VarChar(30) // OWNER / APPROVER / VIEWER...
  assignedAt      DateTime @default(now()) @map("assigned_at") @db.Timestamp(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@id([userId, quotationId])
  @@map("user_quotations")
}

// ============================================================
// DANH MỤC & TEMPLATE
// ============================================================

model Category {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(150)
  slug      String?  @unique @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // 1-N: category -> template
  templates Template[]

  @@map("categories")
}

model Template {
  id         BigInt    @id @default(autoincrement())
  categoryId BigInt    @map("category_id")
  name       String    @db.VarChar(200)
  subject    String?   @db.VarChar(255)
  body       String?   @db.Text
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  category      Category                @relation(fields: [categoryId], references: [id])
  // 1-N: template -> quotation_template_sends
  templateSends QuotationTemplateSend[]
  // 1-N: template -> customer
  customers     Customer[]

  @@map("templates")
}

// Template gửi báo giá. 1-N từ quotation và từ template.
model QuotationTemplateSend {
  id          BigInt    @id @default(autoincrement())
  quotationId BigInt    @map("quotation_id")
  templateId  BigInt    @map("template_id")
  sentTo      String?   @map("sent_to") @db.VarChar(255)
  sentAt      DateTime? @map("sent_at") @db.Timestamp(6)
  status      String    @default("PENDING") @db.VarChar(30)
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  template  Template  @relation(fields: [templateId], references: [id])

  @@map("quotation_template_sends")
}

// ============================================================
// KHÁCH HÀNG & AUDIT LOG
// ============================================================

model Customer {
  id         BigInt   @id @default(autoincrement())
  templateId BigInt   @map("template_id")
  name       String   @db.VarChar(255)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(255)
  address    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  template Template  @relation(fields: [templateId], references: [id])
  // 1-1: customer -> audit_log
  auditLog AuditLog?

  @@map("customers")
}

// 1-1 với customer (customer_id unique). changed_by tham chiếu users.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  customerId BigInt   @unique @map("customer_id")
  action     String?  @db.VarChar(50)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  changedBy  BigInt?  @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamp(6)

  customer      Customer @relation(fields: [customerId], references: [id])
  changedByUser User?    @relation("AuditLogChangedBy", fields: [changedBy], references: [id])

  @@map("audit_logs")
}
