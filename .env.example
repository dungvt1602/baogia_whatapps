# URL của backend NestJS (đích proxy phía server: /api/... -> ${BACKEND_URL}/api/...)
BACKEND_URL=http://localhost:4000

# Để trống = gọi cùng origin qua proxy /api
NEXT_PUBLIC_API_URL=

# Realtime hộp thư (Supabase) — tuỳ chọn, bỏ trống thì tính năng realtime tắt
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
